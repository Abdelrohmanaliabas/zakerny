<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/prayer_widget_bg"
    android:padding="12dp">

    <!-- Header: App title, icon & next prayer badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_app_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_stat_zekrni"
            android:contentDescription="icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ذكرني • مواقيت الصلاة"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="القاهرة • مواقيت اليوم المبارك"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_next_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/prayer_chip_bg"
            android:text="العصر ٠٣:٤٥ م"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- Divider Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- 6 Prayer Times Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="6"
        android:gravity="center">

        <!-- Fajr -->
        <LinearLayout
            android:id="@+id/widget_fajr_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/prayer_inactive_item_bg"
            android:paddingVertical="6dp"
            android:layout_marginHorizontal="2dp">

            <TextView
                android:id="@+id/widget_fajr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الفجر"
                android:textColor="#475569"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_fajr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04:30"
                android:textColor="#0F172A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Sunrise -->
        <LinearLayout
            android:id="@+id/widget_sunrise_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/prayer_inactive_item_bg"
            android:paddingVertical="6dp"
            android:layout_marginHorizontal="2dp">

            <TextView
                android:id="@+id/widget_sunrise_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الشروق"
                android:textColor="#475569"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_sunrise_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05:55"
                android:textColor="#0F172A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dhuhr -->
        <LinearLayout
            android:id="@+id/widget_dhuhr_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/prayer_inactive_item_bg"
            android:paddingVertical="6dp"
            android:layout_marginHorizontal="2dp">

            <TextView
                android:id="@+id/widget_dhuhr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الظهر"
                android:textColor="#475569"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_dhuhr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11:53"
                android:textColor="#0F172A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:id="@+id/widget_asr_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/prayer_active_item_bg"
            android:paddingVertical="6dp"
            android:layout_marginHorizontal="2dp">

            <TextView
                android:id="@+id/widget_asr_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العصر"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_asr_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03:18"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:id="@+id/widget_maghrib_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/prayer_inactive_item_bg"
            android:paddingVertical="6dp"
            android:layout_marginHorizontal="2dp">

            <TextView
                android:id="@+id/widget_maghrib_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المغرب"
                android:textColor="#475569"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_maghrib_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="05:42"
                android:textColor="#0F172A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Isha -->
        <LinearLayout
            android:id="@+id/widget_isha_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/prayer_inactive_item_bg"
            android:paddingVertical="6dp"
            android:layout_marginHorizontal="2dp">

            <TextView
                android:id="@+id/widget_isha_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العشاء"
                android:textColor="#475569"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_isha_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07:00"
                android:textColor="#0F172A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
