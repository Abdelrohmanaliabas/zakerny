<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- The Complete 3D AL-FAJIA Physical Azan Clock Shell -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- 1. Top Pointed Dome Arch with Crescent and AL-FAJIA Logo -->
        <ImageView
            android:id="@+id/widget_arch_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/al_fajia_arch_header"
            android:contentDescription="Al-Fajia Dome Arch" />

        <!-- 2. Middle Body: Left 3D Pillar + Dial Face + Right 3D Pillar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Left 3D Cylindrical Golden Pillar -->
            <ImageView
                android:id="@+id/widget_pillar_left"
                android:layout_width="22dp"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/al_fajia_pillar_left"
                android:contentDescription="Left Pillar" />

            <!-- Center Dial Face (Dial over Haram Makkah Background) -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#FAF8F2">

                <!-- Haram Background Illustration -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/haram_clock_bg"
                    android:contentDescription="Haram Background" />

                <!-- Dial Content Overlay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingLeft="5dp"
                    android:paddingRight="5dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">

                    <!-- Gauges Row: TEMP, City Name, IQAMAH -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="2dp">

                        <!-- Temp -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TEMP"
                                android:textColor="#475569"
                                android:textSize="7sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/widget_temp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/prayer_clock_bezel"
                                android:paddingLeft="3dp"
                                android:paddingRight="3dp"
                                android:text="22°C"
                                android:textColor="#FF2222"
                                android:textSize="9sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- City Name -->
                        <TextView
                            android:id="@+id/widget_city"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="ساعة الحرمين • مدينة السادات"
                            android:textColor="#78350F"
                            android:textSize="9sp"
                            android:textStyle="bold"
                            android:singleLine="true" />

                        <!-- Iqamah -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="IQAMAH"
                                android:textColor="#475569"
                                android:textSize="7sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/widget_iqamah"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/prayer_clock_bezel"
                                android:paddingLeft="3dp"
                                android:paddingRight="3dp"
                                android:text="21°F"
                                android:textColor="#FF2222"
                                android:textSize="9sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Main Red LED Digital Clock -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/prayer_clock_bezel"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:layout_marginBottom="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AM\nPM"
                            android:textColor="#881313"
                            android:textSize="6sp"
                            android:textStyle="bold"
                            android:layout_marginRight="4dp" />

                        <TextView
                            android:id="@+id/widget_main_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="01:42"
                            android:textColor="#FF2222"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• DST"
                            android:textColor="#881313"
                            android:textSize="6sp"
                            android:layout_marginLeft="4dp" />
                    </LinearLayout>

                    <!-- Date Matrix Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/prayer_clock_bezel"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:layout_marginBottom="2dp">

                        <TextView
                            android:id="@+id/widget_date_greg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="01 OCT 2026"
                            android:textColor="#FF3B3B"
                            android:textSize="8sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" | "
                            android:textColor="#551111"
                            android:textSize="8sp" />

                        <TextView
                            android:id="@+id/widget_date_hijri"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20 ربيع الثاني 1448"
                            android:textColor="#FF9933"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 6 Prayer Rows (evenly weighted) -->
                    <!-- 1. AL FAJR -->
                    <LinearLayout
                        android:id="@+id/widget_fajr_bg"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingLeft="2dp"
                        android:paddingRight="2dp">

                        <TextView
                            android:id="@+id/widget_fajr_en"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:text="AL FAJR"
                            android:textColor="#0F2440"
                            android:textSize="8.5sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed" />

                        <TextView
                            android:id="@+id/widget_fajr_time"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/prayer_clock_bezel"
                            android:gravity="center"
                            android:text="04:22"
                            android:textColor="#FF2222"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <ImageView
                            android:id="@+id/widget_fajr_led"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_marginLeft="4dp"
                            android:layout_marginRight="4dp"
                            android:src="@drawable/prayer_led_inactive"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/widget_fajr_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="right|end"
                            android:text="الفجر"
                            android:textColor="#0F2440"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 2. SHUROQ -->
                    <LinearLayout
                        android:id="@+id/widget_shuroq_bg"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingLeft="2dp"
                        android:paddingRight="2dp">

                        <TextView
                            android:id="@+id/widget_shuroq_en"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:text="SHUROQ"
                            android:textColor="#0F2440"
                            android:textSize="8.5sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed" />

                        <TextView
                            android:id="@+id/widget_shuroq_time"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/prayer_clock_bezel"
                            android:gravity="center"
                            android:text="05:39"
                            android:textColor="#FF2222"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <ImageView
                            android:id="@+id/widget_shuroq_led"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_marginLeft="4dp"
                            android:layout_marginRight="4dp"
                            android:src="@drawable/prayer_led_inactive"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/widget_shuroq_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="right|end"
                            android:text="الشروق"
                            android:textColor="#0F2440"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 3. AL ZUHR -->
                    <LinearLayout
                        android:id="@+id/widget_dhuhr_bg"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingLeft="2dp"
                        android:paddingRight="2dp">

                        <TextView
                            android:id="@+id/widget_dhuhr_en"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:text="AL ZUHR"
                            android:textColor="#0F2440"
                            android:textSize="8.5sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed" />

                        <TextView
                            android:id="@+id/widget_dhuhr_time"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/prayer_clock_bezel"
                            android:gravity="center"
                            android:text="11:49"
                            android:textColor="#FF2222"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <ImageView
                            android:id="@+id/widget_dhuhr_led"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_marginLeft="4dp"
                            android:layout_marginRight="4dp"
                            android:src="@drawable/prayer_led_inactive"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/widget_dhuhr_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="right|end"
                            android:text="الظهر"
                            android:textColor="#0F2440"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 4. AL ASR -->
                    <LinearLayout
                        android:id="@+id/widget_asr_bg"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingLeft="2dp"
                        android:paddingRight="2dp">

                        <TextView
                            android:id="@+id/widget_asr_en"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:text="AL ASR"
                            android:textColor="#0F2440"
                            android:textSize="8.5sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed" />

                        <TextView
                            android:id="@+id/widget_asr_time"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/prayer_clock_bezel"
                            android:gravity="center"
                            android:text="03:16"
                            android:textColor="#FF2222"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <ImageView
                            android:id="@+id/widget_asr_led"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_marginLeft="4dp"
                            android:layout_marginRight="4dp"
                            android:src="@drawable/prayer_led_inactive"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/widget_asr_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="right|end"
                            android:text="العصر"
                            android:textColor="#0F2440"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 5. MAGRIB -->
                    <LinearLayout
                        android:id="@+id/widget_maghrib_bg"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingLeft="2dp"
                        android:paddingRight="2dp">

                        <TextView
                            android:id="@+id/widget_maghrib_en"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:text="MAGRIB"
                            android:textColor="#0F2440"
                            android:textSize="8.5sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed" />

                        <TextView
                            android:id="@+id/widget_maghrib_time"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/prayer_clock_bezel"
                            android:gravity="center"
                            android:text="05:57"
                            android:textColor="#FF2222"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <ImageView
                            android:id="@+id/widget_maghrib_led"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_marginLeft="4dp"
                            android:layout_marginRight="4dp"
                            android:src="@drawable/prayer_led_inactive"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/widget_maghrib_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="right|end"
                            android:text="المغرب"
                            android:textColor="#0F2440"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 6. AL ISHA -->
                    <LinearLayout
                        android:id="@+id/widget_isha_bg"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingLeft="2dp"
                        android:paddingRight="2dp">

                        <TextView
                            android:id="@+id/widget_isha_en"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:text="AL ISHA"
                            android:textColor="#0F2440"
                            android:textSize="8.5sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed" />

                        <TextView
                            android:id="@+id/widget_isha_time"
                            android:layout_width="44dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/prayer_clock_bezel"
                            android:gravity="center"
                            android:text="07:27"
                            android:textColor="#FF2222"
                            android:textSize="9.5sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace" />

                        <ImageView
                            android:id="@+id/widget_isha_led"
                            android:layout_width="7dp"
                            android:layout_height="7dp"
                            android:layout_marginLeft="4dp"
                            android:layout_marginRight="4dp"
                            android:src="@drawable/prayer_led_inactive"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/widget_isha_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="right|end"
                            android:text="العشاء"
                            android:textColor="#0F2440"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>

            <!-- Right 3D Cylindrical Golden Pillar -->
            <ImageView
                android:id="@+id/widget_pillar_right"
                android:layout_width="22dp"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/al_fajia_pillar_right"
                android:contentDescription="Right Pillar" />
        </LinearLayout>

        <!-- 3. Bottom Pedestal Base with Physical Buttons -->
        <ImageView
            android:id="@+id/widget_base_console"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/al_fajia_base_console"
            android:contentDescription="Al-Fajia Buttons Base" />

    </LinearLayout>

</FrameLayout>
